# Cache de Python. Nunca debe versionarse: se regenera solo, cambia con cada
# version de Python y ensucia todos los diffs.
__pycache__/
*.py[cod]
*$py.class

# Entornos virtuales. Dependen de rutas absolutas de la maquina que los creo,
# asi que no sirven al clonar el repo en otra computadora.
#
# Para recrear uno: python3 -m venv .venv && pip install mujoco
.venv/
venv/
env/
ENV/

# Estado en ejecucion del simulador
.simulador_activo.json
.pose_actual.json

# Sistema operativo
.DS_Store
Thumbs.db

# Enlace local de Claude a las skills versionadas en .agents.
.claude/

# Dataset crudo de 79.000 repartos (>100 MB); se versiona truco_stats.json
T1K22.json

# Historial local y respaldos de partidas
proyecto/historial_partidas.json
proyecto/historial_partidas.json.*.bak
proyecto/opponent_profile.json

# Training output (populations, per-generation champions, phase 2 checkpoints,
# logs). Large, binary and regenerated by every run; it stays on local disk.
# Only each phase's reigning champion and a copy of its logs are committed,
# under champions/ (see ADR 0018).
training_output/
